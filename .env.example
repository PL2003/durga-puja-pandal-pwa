# Pandal Hop configuration — all values are OPTIONAL.
# The app runs with zero configuration. Never commit real secrets.

# Custom routing provider base URL (defaults to the public OSRM demo endpoint).
# For production, point this at your own OSRM/Valhalla instance or a proxy —
# do NOT embed privileged provider keys in the frontend.
VITE_ROUTING_BASE_URL=""

# Routing request timeout in milliseconds (default 15000).
VITE_ROUTING_TIMEOUT_MS="15000"

# Optional: tile server template if you must replace the default CARTO dark tiles.
VITE_TILE_URL=""

# Optional: background sync interval hint (minutes) used while the app is in the
# foreground. Mobile browsers will still refuse work while the app is closed.
VITE_FOREGROUND_SYNC_MINUTES="5"
